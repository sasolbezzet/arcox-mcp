{
  "name": "arcox-mcp-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "arcox-agent": "./packages/runtime/bin/arcox-codex-cli.mjs"
  },
  "scripts": {
    "agent": "node packages/runtime/bin/arcox-agent.mjs",
    "codex-agent": "node packages/runtime/bin/arcox-codex-cli.mjs",
    "mcp": "node packages/mcp-server/server.mjs",
    "check": "node --check packages/runtime/bin/arcox-agent.mjs && node --check packages/runtime/mcp/server.mjs && node --check packages/mcp-server/server.mjs && node --check packages/cli/bin/arcox.mjs",
    "compile:router": "node packages/runtime/scripts/compile-router.mjs",
    "deploy:router": "node packages/runtime/scripts/deploy-router.mjs",
    "deploy:solana-router": "node packages/runtime/scripts/deploy-solana-router.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "solc": "^0.8.35"
  },
  "overrides": {
    "tmp": "^0.2.7"
  }
}
