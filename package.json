{
  "name": "arcox-mcp",
  "private": false,
  "version": "0.1.11",
  "type": "module",
  "description": "ARCOX DEX MCP server and terminal agent for retail swap, bridge, send, ARCOX Pay invoices, balances, history, retry bridge, and agentic jobs.",
  "license": "MIT",
  "homepage": "https://arc-dex-bice.vercel.app/?page=docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sasolbezzet/arcox-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/sasolbezzet/arcox-mcp/issues"
  },
  "keywords": [
    "arcox",
    "arc",
    "mcp",
    "dex",
    "agent",
    "circle",
    "cctp"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "README.md",
    "CHANGELOG.md",
    "packages/runtime/bin",
    "packages/runtime/mcp",
    "packages/runtime/deployments",
    "packages/runtime/artifacts",
    "packages/runtime/contracts",
    "packages/runtime/profile",
    "packages/runtime/package.json",
    "packages/mcp-server/server.mjs",
    "packages/mcp-server/package.json",
    "packages/cli/bin",
    "packages/cli/package.json"
  ],
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "arcox-mcp": "packages/mcp-server/server.mjs",
    "arcox-agent": "packages/runtime/bin/arcox-codex-cli.mjs",
    "arcox": "packages/cli/bin/arcox.mjs"
  },
  "scripts": {
    "agent": "node packages/runtime/bin/arcox-agent.mjs",
    "codex-agent": "node packages/runtime/bin/arcox-codex-cli.mjs",
    "mcp": "node packages/mcp-server/server.mjs",
    "check": "node --check packages/runtime/bin/arcox-agent.mjs && node --check packages/runtime/mcp/server.mjs && node --check packages/mcp-server/server.mjs && node --check packages/cli/bin/arcox.mjs",
    "compile:router": "node packages/runtime/scripts/compile-router.mjs",
    "deploy:router": "node packages/runtime/scripts/deploy-router.mjs",
    "deploy:solana-router": "node packages/runtime/scripts/deploy-solana-router.mjs",
    "verify:router": "node packages/runtime/scripts/verify-router.mjs"
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bs58": "^6.0.0",
    "viem": "^2.50.4"
  },
  "devDependencies": {
    "solc": "^0.8.35"
  },
  "overrides": {
    "tmp": "^0.2.7"
  }
}
