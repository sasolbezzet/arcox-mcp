{
  "name": "@arcox/runtime",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "arcox-agent": "./bin/arcox-codex-cli.mjs"
  },
  "scripts": {
    "agent": "node bin/arcox-agent.mjs",
    "codex-agent": "node bin/arcox-codex-cli.mjs",
